# Credenciales de la API de DataForSEO (https://app.dataforseo.com/api-access).
# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Ubicación e idioma por defecto (España / español).
DEFAULT_LOCATION_CODE=2724
DEFAULT_LANGUAGE_CODE=es

# Control de gasto (USD).
# Si el coste estimado de una consulta supera este umbral, se pide confirmación.
COST_CONFIRM_THRESHOLD=0.50
# Pedir confirmación cuando aún no se conoce el coste de un endpoint (primera llamada).
CONFIRM_UNKNOWN_COST=true
# Tope de gasto diario. 0 = sin tope.
DAILY_BUDGET=0

# Validación de entradas.
MAX_KEYWORDS_PER_REQUEST=100
MAX_TARGETS_PER_REQUEST=100
MAX_LIMIT=1000
MAX_SERP_DEPTH=100
MAX_CRAWL_PAGES=1000

# Caché y base de datos local.
DATA_DIR=data
CACHE_ENABLED=true

# Red.
HTTP_TIMEOUT_SECONDS=120
